# NAZAR environment template.
# Copy to `.env` (git-ignored) and fill values locally. NEVER commit real values.
# Full explanation of every variable: docs/ENVIRONMENT_SETUP.md
#
# Generate a strong random secret with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"

# =============================================================================
# 1. Non-secret settings (safe defaults; change only if needed)
# =============================================================================
NAZAR_ENV=development
NAZAR_LOG_LEVEL=INFO
NAZAR_API_HOST=127.0.0.1
NAZAR_API_PORT=8000
NAZAR_WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Local artifact/upload storage root (relative to repo root). Git-ignored.
NAZAR_STORAGE_DIR=var/storage
# Upload/validation limits.
NAZAR_MAX_UPLOAD_MB=2048
NAZAR_MAX_VIDEO_SECONDS=900
# Heavy GPU jobs allowed at once per worker. Keep 1 unless profiling proves otherwise.
NAZAR_GPU_MAX_CONCURRENT_JOBS=1
# Worker -> API base URL (the GPU worker pulls jobs over outbound HTTP(S)).
NAZAR_API_BASE_URL=http://127.0.0.1:8000
# `test` = deterministic fixture pipeline (no GPU, no weights). `real` = research models.
NAZAR_PIPELINE_MODE=test

# =============================================================================
# 2. REQUIRED secrets (needed from Milestone 2: accounts, worker auth, signed links)
#    These are generated by YOU locally - they are not third-party API keys.
# =============================================================================
# Signs short-lived artifact download links and session cookies.
NAZAR_SECRET_KEY=
# Shared bearer token the GPU worker uses to lease jobs and upload artifacts.
NAZAR_WORKER_TOKEN=
# OPTIONAL. Normally you create the first operator account in the web app on first run
# (allowed only from this machine, only while no account exists, never in production).
# Set both only for headless/production setups; the account is created on start if none exists.
NAZAR_BOOTSTRAP_ADMIN_EMAIL=
NAZAR_BOOTSTRAP_ADMIN_PASSWORD=

# =============================================================================
# 3. OPTIONAL - leave blank unless you use the service
# =============================================================================
# Blank => local SQLite file under NAZAR_STORAGE_DIR. Set for PostgreSQL/PostGIS, e.g.
# postgresql+psycopg://nazar:<password>@127.0.0.1:5432/nazar
NAZAR_DATABASE_URL=
# Blank => in-process event fan-out (single API instance). Set for multi-instance API.
NAZAR_REDIS_URL=
# Blank => local filesystem storage. Set all four for S3-compatible storage (MinIO).
NAZAR_S3_ENDPOINT_URL=
NAZAR_S3_BUCKET=
NAZAR_S3_ACCESS_KEY_ID=
NAZAR_S3_SECRET_ACCESS_KEY=
# GPU model runtime (paths, not secrets). Blank => the worker uses what `pnpm gpu:setup`
# installed under var/gpu (main-env, splat-env, weights) when present, else the CPU baseline,
# and says so in the job. Setup: docs/ENVIRONMENT_SETUP.md ("GPU models").
# Only set these to use an environment somewhere else.
# Fast3R interpreter, e.g. var/gpu/main-env/Scripts/python.exe
NAZAR_FAST3R_PYTHON=
# Local checkpoint directory containing model.safetensors, e.g. var/gpu/weights/Fast3R_ViT_Large_512
NAZAR_FAST3R_WEIGHTS=
# Views per forward pass. 0 => sized from free GPU memory (halved automatically on OOM).
NAZAR_FAST3R_MAX_VIEWS=0
# Hugging Face token. Only needed if a selected model's weights are gated, or to avoid
# anonymous download rate limits on the GPU machine.
HF_TOKEN=

# =============================================================================
# 4. NOT needed for local development - only for infra/docker-compose.yml
# =============================================================================
POSTGRES_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
