{
  "$defs": {
    "ArtifactAvailable": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "$ref": "#/$defs/ArtifactManifest"
        },
        "job_id": {
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "type": "integer"
        },
        "seq": {
          "minimum": 1,
          "type": "integer"
        },
        "stage": {
          "anyOf": [
            {
              "$ref": "#/$defs/StageName"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "$ref": "#/$defs/JobStatus"
        },
        "ts": {
          "format": "date-time",
          "type": "string"
        },
        "type": {
          "const": "artifact.available",
          "type": "string"
        }
      },
      "required": [
        "job_id",
        "seq",
        "ts",
        "status",
        "type",
        "data"
      ],
      "title": "ArtifactAvailable",
      "type": "object"
    },
    "ArtifactKind": {
      "enum": [
        "keyframes",
        "point_cloud_preview",
        "point_cloud",
        "camera_trajectory",
        "depth_maps",
        "dynamic_masks",
        "gaussian_scene",
        "mesh",
        "report",
        "export"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "ArtifactManifest": {
      "additionalProperties": false,
      "properties": {
        "bounds": {
          "anyOf": [
            {
              "$ref": "#/$defs/Bounds3D"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "byte_size": {
          "minimum": 0,
          "type": "integer"
        },
        "checksum_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "frame": {
          "anyOf": [
            {
              "$ref": "#/$defs/CoordinateFrame"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "type": "string"
        },
        "job_id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "lod": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "media_type": {
          "type": "string"
        },
        "point_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "revision": {
          "description": "Monotonic per (job, kind); stale revisions are ignored.",
          "minimum": 1,
          "type": "integer"
        },
        "source_frames": {
          "anyOf": [
            {
              "$ref": "#/$defs/FrameRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "transform_to_frame": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "maxItems": 16,
              "minItems": 16,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Column-major 4x4 from artifact-local coords to `frame`."
        }
      },
      "required": [
        "id",
        "job_id",
        "kind",
        "revision",
        "media_type",
        "byte_size",
        "checksum_sha256",
        "provenance",
        "created_at"
      ],
      "title": "ArtifactManifest",
      "type": "object"
    },
    "Bounds3D": {
      "additionalProperties": false,
      "properties": {
        "max": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "min": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        }
      },
      "required": [
        "min",
        "max"
      ],
      "title": "Bounds3D",
      "type": "object"
    },
    "CancelRequested": {
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
