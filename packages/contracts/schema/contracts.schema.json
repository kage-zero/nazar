        },
        "first_index": {
          "minimum": 0,
          "type": "integer"
        },
        "last_index": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "first_index",
        "last_index",
        "count"
      ],
      "title": "FrameRange",
      "type": "object"
    },
    "FrameType": {
      "enum": [
        "local_reconstruction",
        "enu",
        "ecef",
        "geographic",
        "projected"
