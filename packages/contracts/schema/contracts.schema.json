      "required": [
        "job_id",
        "seq",
        "ts",
        "status",
        "type"
      ],
      "title": "CancelRequested",
      "type": "object"
    },
    "CheckStatus": {
      "enum": [
        "ok",
        "degraded",
        "unavailable",
        "not_configured",
        "not_implemented"
      ],
      "title": "CheckStatus",
      "type": "string"
    },
    "CoordinateFrame": {
      "additionalProperties": false,
      "properties": {
        "axes": {
          "default": "right-handed; +X right, +Y up, -Z forward (OpenGL camera convention)",
          "description": "Axis convention of stored coordinates.",
          "type": "string"
        },
        "crs": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "EPSG/WKT identifier when georeferenced."
        },
        "scale_status": {
          "$ref": "#/$defs/ScaleStatus"
        },
        "type": {
          "$ref": "#/$defs/FrameType"
        },
        "units": {
          "description": "Linear units of coordinates, e.g. 'metre' or 'unitless'.",
          "type": "string"
        },
        "vertical_datum": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "type",
        "units",
        "scale_status"
      ],
      "title": "CoordinateFrame",
      "type": "object"
    },
    "EventType": {
      "enum": [
        "job.created",
        "stage.started",
        "stage.progress",
        "stage.completed",
        "stage.skipped",
        "warning",
        "artifact.available",
        "preview.updated",
        "job.completed",
        "job.failed",
        "cancel.requested",
        "job.cancelled"
      ],
      "title": "EventType",
      "type": "string"
    },
    "FrameRange": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "minimum": 0,
