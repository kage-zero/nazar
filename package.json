{
  "name": "nazar",
  "private": true,
  "description": "Single-pass drone video to progressive 3D reconstruction",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "contracts:generate": "turbo run contracts:generate",
    "contracts:check": "turbo run contracts:check",
    "check": "turbo run lint typecheck test contracts:check",
    "worker": "uv run --package nazar-worker nazar-worker run --modes test,standard --step-delay 0.8",
    "env:init": "uv run python scripts/init_env.py",
    "gpu:setup": "uv run python scripts/setup_gpu.py",
    "gpu:check": "uv run python scripts/setup_gpu.py --check",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "turbo": "2.11.10"
  }
}
